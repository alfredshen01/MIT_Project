# 複製這個檔案為 .env,再依下方說明填入設定
# cp .env.example .env

# 資料庫連線字串
# 本地用 Docker 跑 postgres 時用 localhost;若用 docker-compose 跑整套則改成 db
DATABASE_URL=postgresql://postgres:pwd@localhost:5432/mit_project

# JWT 簽章金鑰 — 請自己產生一組,不要直接用這行範例值
# 產生方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# 允許的前端來源(本地開發 = Vite 預設的 5173)
FRONTEND_ORIGIN=http://localhost:5173

# (選填)轉換後檔案的存放目錄;留空則預設存在後端的 ./uploads
# UPLOAD_DIR=./uploads
